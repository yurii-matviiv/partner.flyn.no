APP_NAME="FLYN Partner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://partner.flyn.no.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=flyn_partner_session

# Use the shared local MySQL database for development.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
